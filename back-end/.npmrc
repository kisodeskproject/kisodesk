# Forzar que todas las dependencias se guarden con la versión exacta
save-exact=true

# Evitar que npm genere warnings sobre scripts en subpaquetes
ignore-scripts=false

# Asegurar que los binarios de paquetes locales estén en el PATH
scripts-prepend-node-path=true

# Configuración de workspaces
workspaces=false

# Evitar conflictos de lockfiles en un monorepo
package-lock=true
