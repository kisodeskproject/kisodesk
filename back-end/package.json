{
  "name": "backend",
  "private": true,
  "_moduleAliases": {
    "@prisma": "prisma"
  },
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "prebuild": "rimraf dist",
    "build": "tsc -p tsconfig.build.json",
    "env": "dotenv -e ${ENV_FILE:-.env}",
    "prisma:generate": "dotenv -e .env prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "dotenv -e .env prisma migrate dev --name init --schema=prisma/schema.prisma",
    "prisma:deploy": "dotenv -e .env prisma migrate deploy --schema=prisma/schema.prisma",
    "index:practice-corpus": "npm run env -- ts-node src/scripts/index-practice-corpus.ts",
    "index:practice-corpus:prod": "node dist/scripts/index-practice-corpus.js",
    "sync:practice-texts": "npm run env -- ts-node src/scripts/sync-practice-texts.ts",
    "sync:practice-texts:prod": "node dist/scripts/sync-practice-texts.js",
    "lint": "eslint . --ext .ts,.js",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@fastify/compress": "^7.0.0",
    "@fastify/cookie": "^9.0.0",
    "@fastify/cors": "^8.0.0",
    "@fastify/helmet": "^11.0.0",
    "@nestjs/axios": "^3.0.2",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "^2.0.5",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-fastify": "^10.4.15",
    "@nestjs/terminus": "^10.2.3",
    "@nestjs/throttler": "^5.1.2",
    "@opentelemetry/auto-instrumentations-node": "0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@prisma/client": "^6.14.0",
    "@willsoto/nestjs-prometheus": "^6.0.2",
    "axios": "^1.12.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "1.4.7",
    "fastify": "^4.28.1",
    "fastify-plugin": "^5.0.0",
    "joi": "^18.0.1",
    "minio": "8.0.6",
    "nodemailer": "8.0.11",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@nestjs/cli": "^10.4.5",
    "@nestjs/testing": "^10.4.15",
    "@types/babel__generator": "7.27.0",
    "@types/babel__template": "7.4.4",
    "@types/babel__traverse": "7.28.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "25.5.0",
    "@types/nodemailer": "8.0.1",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/serve-static": "2.2.0",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "8.56.0",
    "@typescript-eslint/parser": "8.56.0",
    "dotenv-cli": "^7.4.2",
    "eslint": "9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-boundaries": "5.2.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.7.0",
    "lint-staged": "16.1.6",
    "prettier": "3.6.2",
    "prisma": "^6.14.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
